# ─────────────────────────────────────────────────────────────────────────────
# DIRAC — Environment Variable Reference
#
# Copy this file to .env and fill in any values you want to override.
# All variables are optional; sensible defaults are shown below.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── RAG Data Paths ────────────────────────────────────────────────────────────

# Path to the FAISS index file built during data preprocessing.
# Default: data/processed/faiss.index  (relative to project root)
DIRAC_INDEX=data/processed/faiss.index

# Path to the chunked corpus JSONL file used for retrieval metadata.
# Default: data/processed/chunked_corpus.jsonl  (relative to project root)
DIRAC_METADATA=data/processed/chunked_corpus.jsonl


# ── Model Configuration ───────────────────────────────────────────────────────

# HuggingFace model ID (or local path) for the base causal language model.
# Default: meta-llama/Llama-3.2-3B-Instruct
# NOTE: Accessing gated models requires HUGGINGFACE_TOKEN to be set.
DIRAC_MODEL=meta-llama/Llama-3.2-3B-Instruct

# HuggingFace repo ID or local directory path for the LoRA adapter.
# PeftModel.from_pretrained accepts both formats.
# Default: Navyasri12355/llama-3.2-3b-arxiv-lora
DIRAC_ADAPTER=Navyasri12355/llama-3.2-3b-arxiv-lora


# ── HuggingFace Authentication ────────────────────────────────────────────────

# Required to download gated models (e.g. Llama-3.2) from the HuggingFace Hub.
# Generate a token at: https://huggingface.co/settings/tokens
# Leave blank if using a fully public adapter and a locally cached base model.
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Server ────────────────────────────────────────────────────────────────────

# Port the Flask API server listens on.
# Default: 5000
PORT=5000
